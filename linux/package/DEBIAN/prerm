#!/bin/sh
set -e

if [ "$1" = "remove" ]; then
    # Stop running tray apps so none keeps unbinding the keyboard after removal
    pkill -f /usr/bin/laptop-keyboard-auto-toggle 2>/dev/null || true
    rm -f /run/laptop-keyboard-auto-toggle.paused
fi

# Always re-enable internal keyboard before uninstalling (postinst re-applies on upgrade)
/usr/bin/laptop-keyboard-toggle-helper enable 2>/dev/null || true

exit 0
