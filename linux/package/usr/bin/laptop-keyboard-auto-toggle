#!/usr/bin/env python3
"""
Laptop Keyboard Auto-Toggle (Linux / Ubuntu) - tray indicator.
The automatic switching is done by a udev rule, from boot and before login: plugging the
configured USB dongle disables the internal PS/2 keyboard, unplugging re-enables it.
This AppIndicator tray icon shows the state and offers dongle choice, pause and manual control.
"""

import sys
import os
import fcntl
import signal
import subprocess
import logging

try:
    import gi
    gi.require_version('Gtk', '3.0')
    try:
        gi.require_version('AyatanaAppIndicator3', '0.1')
        from gi.repository import AyatanaAppIndicator3 as AppIndicator
    except (ValueError, ImportError):
        gi.require_version('AppIndicator3', '0.1')
        from gi.repository import AppIndicator3 as AppIndicator
    from gi.repository import Gtk, GLib
except Exception as e:
    print(f"Error loading GTK / AppIndicator libraries: {e}", file=sys.stderr)
    print("Please run: sudo apt install python3-gi gir1.2-ayatanaappindicator3-0.1", file=sys.stderr)
    sys.exit(1)

try:
    import pyudev
except ImportError:
    print("Error loading pyudev. Please run: sudo apt install python3-pyudev", file=sys.stderr)
    sys.exit(1)

logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] %(message)s')

LOCK_DIR = os.path.expanduser("~/.config/laptop-keyboard-auto-toggle")
HELPER = "/usr/bin/laptop-keyboard-toggle-helper"
PAUSE_FLAG = "/run/laptop-keyboard-auto-toggle.paused"
POLL_SECONDS = 2


def run_helper(*args, root=False):
    # -n: fail instead of hanging on a password prompt nobody can see
    cmd = (["sudo", "-n"] if root else []) + [HELPER, *args]
    try:
        return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout.strip()
    except Exception as e:
        logging.error(f"Keyboard helper {' '.join(args)} failed: {e}")
        return ""


class KeyboardAutoToggleApp:
    def __init__(self):
        self.load_config()
        self.devices = None

        self.indicator = AppIndicator.Indicator.new(
            "laptop-keyboard-auto-toggle",
            "input-keyboard",
            AppIndicator.IndicatorCategory.HARDWARE
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)

        self.menu = Gtk.Menu()
        self.status_item = Gtk.MenuItem(label="Status: Initializing...")
        self.status_item.set_sensitive(False)
        self.menu.append(self.status_item)

        self.menu.append(Gtk.SeparatorMenuItem())

        self.toggle_item = Gtk.MenuItem(label="Turn Keyboard OFF")
        self.toggle_item.connect("activate", self.on_manual_toggle)
        self.menu.append(self.toggle_item)

        self.pause_item = Gtk.CheckMenuItem(label="Pause USB Auto-Toggle")
        self.pause_item.set_active(os.path.exists(PAUSE_FLAG))  # before connect: no signal
        self.pause_item.connect("toggled", self.on_pause_toggled)
        self.menu.append(self.pause_item)

        self.dongle_item = Gtk.MenuItem(label="Choose Wireless Dongle")
        self.menu.append(self.dongle_item)

        self.safety_item = Gtk.MenuItem(label="Enable internal keyboard now")
        self.safety_item.connect("activate", lambda w: self.change_keyboard("enable"))
        self.menu.append(self.safety_item)

        self.menu.append(Gtk.SeparatorMenuItem())

        self.quit_item = Gtk.MenuItem(label="Quit (auto-toggle keeps working)")
        self.quit_item.connect("activate", lambda w: Gtk.main_quit())
        self.menu.append(self.quit_item)

        self.menu.show_all()
        self.indicator.set_menu(self.menu)

        self.udev_ctx = pyudev.Context()
        self.refresh()
        # udev switches the keyboard in the background (an unbind takes seconds), so poll
        GLib.timeout_add_seconds(POLL_SECONDS, self.refresh)

    def load_config(self):
        parts = run_helper("config").split()  # "vvvv:pppp serioN"
        self.dongle = parts[0] if parts else ""
        self.serio_dev = parts[1] if len(parts) > 1 else "serio0"
        logging.info(f"Configured dongle: {self.dongle or 'unknown'}, keyboard port: {self.serio_dev}")

    def connected_hid_devices(self):
        """{'vvvv:pppp': name} of connected USB devices with a HID (keyboard/mouse) interface."""
        devices = {}
        for intf in self.udev_ctx.list_devices(subsystem='usb', DEVTYPE='usb_interface'):
            if not intf.properties.get('INTERFACE', '').startswith('3/'):  # 3 = HID class
                continue
            dev = intf.find_parent('usb', 'usb_device')
            if dev is None:
                continue
            props = dev.properties
            dongle_id = f"{props.get('ID_VENDOR_ID', '')}:{props.get('ID_MODEL_ID', '')}".lower()
            vendor = props.get('ID_VENDOR_FROM_DATABASE') or props.get('ID_VENDOR', '')
            model = props.get('ID_MODEL_FROM_DATABASE') or props.get('ID_MODEL', '')
            devices[dongle_id] = f"{vendor} {model}".replace('_', ' ').strip()
        return devices

    def refresh(self):
        devices = self.connected_hid_devices()
        if devices != self.devices:
            self.devices = devices
            self.rebuild_dongle_menu()

        kb_on = os.path.exists(f"/sys/bus/serio/drivers/atkbd/{self.serio_dev}")
        dongle_str = "PLUGGED" if self.dongle in devices else "UNPLUGGED"
        paused_str = " | PAUSED" if os.path.exists(PAUSE_FLAG) else ""
        self.status_item.set_label(f"Internal KB: {'ON' if kb_on else 'OFF'} | Dongle: {dongle_str}{paused_str}")
        self.toggle_item.set_label("Turn Keyboard OFF" if kb_on else "Turn Keyboard ON")
        self.kb_on = kb_on
        return GLib.SOURCE_CONTINUE

    def rebuild_dongle_menu(self):
        submenu = Gtk.Menu()
        for dongle_id, name in sorted(self.devices.items()):
            item = Gtk.CheckMenuItem(label=f"{name} ({dongle_id})")
            item.set_active(dongle_id == self.dongle)
            item.connect("activate", self.on_dongle_chosen, dongle_id)  # after set_active, which also emits it
            submenu.append(item)
        if not self.devices:
            empty = Gtk.MenuItem(label="No USB keyboard/mouse receivers connected")
            empty.set_sensitive(False)
            submenu.append(empty)
        submenu.show_all()
        self.dongle_item.set_submenu(submenu)

    def on_dongle_chosen(self, widget, dongle_id):
        logging.info(f"Dongle chosen from menu: {dongle_id}")
        run_helper("set-dongle", dongle_id, root=True)
        self.load_config()
        self.devices = None  # rebuild the menu (outside this signal) with the new check mark
        GLib.idle_add(self.refresh)

    def change_keyboard(self, action):
        logging.info(f"Manual: {action} internal keyboard ({self.serio_dev})")
        run_helper(action, root=True)
        self.refresh()

    def on_manual_toggle(self, widget):
        self.change_keyboard("disable" if self.kb_on else "enable")

    def on_pause_toggled(self, widget):
        paused = widget.get_active()
        logging.info(f"USB Auto-Toggle paused = {paused}")
        run_helper("pause" if paused else "resume", root=True)
        self.refresh()


def main():
    # Single instance: autostart and the app-menu launcher must not both add an icon
    os.makedirs(LOCK_DIR, exist_ok=True)
    lock_file = open(os.path.join(LOCK_DIR, ".lock"), "w")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        logging.info("Already running; exiting.")
        sys.exit(0)

    for sig in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, Gtk.main_quit)

    KeyboardAutoToggleApp()
    Gtk.main()


if __name__ == "__main__":
    main()
